# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every variable here is validated at boot by
# src/config/env.ts — a missing or malformed value stops the process.
# ---------------------------------------------------------------------------

NODE_ENV=
PORT=

# Postgres 16. With `docker compose up` the host is the compose service name (`db`);
# against a Postgres installed on the host it is localhost.
DATABASE_URL=

# Signing key for the 15-minute bearer tokens. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Run the seed script on boot (the compose entrypoint reads this).
SEED=

# Echo every SQL statement Prisma emits. Turn on for the walkthrough proof that an
# interviewer-scoped query never names the restricted columns.
LOG_QUERIES=

# PLAN.md §1 layer 3: run interviewer reads as the `app_interviewer` role, which Postgres
# has stripped of email/phone and put behind a row policy. `auto` (the default) uses it
# where `npm run db:rls` has been run and carries on without it where it has not;
# `require` makes a missing role a boot failure; `off` never switches role.
# DB_RLS=auto

# Serve GET /docs (Swagger UI) and GET /openapi.json. These are anonymous routes, so the
# default is derived rather than fixed: on outside production, off in it. Set explicitly
# to override — compose does, so the walkthrough has a browsable API.
# ENABLE_DOCS=true
