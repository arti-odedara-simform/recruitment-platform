{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://recruitment-platform-x8ed.onrender.com/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
